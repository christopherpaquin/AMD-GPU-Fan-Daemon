[Unit]
Description=AMD GPU-Aware Motherboard Fan Control Daemon
After=multi-user.target
StartLimitIntervalSec=600
StartLimitBurst=8

[Service]
Type=notify
NotifyAccess=main
User=root
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
RuntimeDirectory=amd-gpu-fan-daemon
ExecStart=/usr/bin/python3 -m fan_daemon
ExecStopPost=/usr/bin/python3 -m fan_daemon --revert-to-auto
Restart=on-failure
RestartSec=5
WatchdogSec=30

# Sandboxing - see README "Security notes" for the rationale behind each.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/sys/class/hwmon
ProtectKernelTunables=no
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
