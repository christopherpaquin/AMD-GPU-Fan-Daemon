# AMD-GPU-Fan-Daemon runtime configuration.
# No secrets live here - copy to .env (install.sh does this automatically)
# and edit freely. The daemon must be restarted to pick up changes:
#   sudo systemctl restart amd-gpu-fan-daemon

# --- Control loop timing ---
# How often to sample temps and re-evaluate targets.
POLL_INTERVAL_SECONDS=2
# Minimum seconds between two PWM writes on the same header, even if the
# curve says otherwise - bounds worst-case audible fan-speed chatter.
MIN_DWELL_SECONDS=8
# A header's target is only re-evaluated once its driving temp has moved
# at least this many degrees C since the last evaluation.
TEMP_DEADBAND_C=2
# A write only happens if the new target differs from the last applied
# value by at least this many PWM counts (0-255 scale).
PWM_STEP_THRESHOLD=3
# Exponential moving average smoothing factor for temp readings, in (0, 1].
# Lower = smoother/slower to react, higher = more responsive to spikes.
EMA_ALPHA=0.3

# --- Managed fan headers (nct6797 PWM channel numbers) ---
# Space-separated list of the motherboard headers this daemon controls.
# Confirm your board's populated headers with: sensors | grep '^fan'
FAN_HEADERS="2 4 7"

# --- PWM output range (0-255 scale) ---
# PWM_MIN=64 (~25%) keeps fans always moving at idle rather than
# stopping/starting, which is easier on cheap fan motors over time.
PWM_MIN=64
PWM_MAX=255

# --- Curve breakpoints: "temp_c:pwm temp_c:pwm ..." ascending, linear
# interpolation between points, clamped flat outside the range. The final
# PWM per header is max(cpu_curve_result, gpu_curve_result) - this daemon
# adds GPU responsiveness without regressing the existing CPU-driven
# behavior the BIOS/chip already provided. ---
CPU_CURVE="40:64 55:115 70:191 85:255"
GPU_CURVE="45:64 65:102 80:179 90:230 95:255"

# --- hwmon device resolution ---
# Resolved dynamically by matching the hwmon device's `name` file - the
# numeric hwmon path (hwmon0, hwmon1, ...) is NOT stable across reboots.
# Confirm your chip names with: for f in /sys/class/hwmon/*/name; do echo "$f: $(cat $f)"; done
CPU_HWMON_NAME=nct6797
GPU_HWMON_NAME=amdgpu
CPU_TEMP_ATTR=temp7_input
GPU_TEMP_ATTR=temp2_input

# --- Fail-safe ---
# pwm*_enable value written to every managed header when the daemon stops
# (cleanly, crashes, or is killed) - 5 hands control back to the chip's own
# hardware Smart-Fan curve. Do not change unless you know your chip's modes.
FAILSAFE_PWM_ENABLE=5
HEARTBEAT_FILE=/run/amd-gpu-fan-daemon/heartbeat
HEARTBEAT_STALE_SECONDS=30

LOG_LEVEL=INFO
